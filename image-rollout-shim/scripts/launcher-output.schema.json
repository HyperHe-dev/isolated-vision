{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report", "meta"],
      "properties": {
        "status": {"const": "ok"},
        "report": {"$ref": "report.schema.json"},
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "source_images",
            "private_attachments",
            "worker_session",
            "raw_worker_output_forwarded",
            "effective_model"
          ],
          "properties": {
            "mode": {"type": "string", "enum": ["standard", "thorough"]},
            "source_images": {"type": "integer", "minimum": 1, "maximum": 8},
            "private_attachments": {"type": "integer", "minimum": 1, "maximum": 48},
            "worker_session": {"const": "ephemeral"},
            "raw_worker_output_forwarded": {"const": false},
            "effective_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,127}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": {"const": "error"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"}
          }
        }
      }
    }
  ]
}
