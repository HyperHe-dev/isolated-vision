{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "observations",
    "answers",
    "uncertainties",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.2"]
    },
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "observations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "detail",
          "location",
          "confidence"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "detail": {
            "type": "string",
            "maxLength": 4000
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image_index", "description", "x", "y", "width", "height"],
            "properties": {
              "image_index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "x": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_index", "answer", "confidence"],
        "properties": {
          "question_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "answer": {
            "type": "string",
            "maxLength": 5000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_images",
        "attachments",
        "reviewed_regions",
        "limitations"
      ],
      "properties": {
        "source_images": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "attachments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "reviewed_regions": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
